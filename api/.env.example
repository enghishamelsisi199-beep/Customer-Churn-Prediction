# Path to the trained pipeline (from model_training/)
MODEL_PATH=../model_training/models/churn_model_tuned.pkl

# Where a replaced model's previous version is backed up before being overwritten
MODEL_BACKUP_DIR=./model_backups

# /retrain rejects uploads with fewer rows than this (too small to train/evaluate reliably)
MIN_ROWS_FOR_RETRAIN=100

RANDOM_STATE=42
CHURN_THRESHOLD=0.5

API_HOST=0.0.0.0
API_PORT=8001
ALLOWED_ORIGINS=*
